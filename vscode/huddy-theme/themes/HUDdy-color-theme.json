  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7d93ad",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#5ee1ff"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#93a8bf"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#93a8bf"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#3dffa8"
      }
    },
    {
      "name": "String escape",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#3ef0ff"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.other.color",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#ffb547"
      }
    },
    {
      "name": "Language constant",
      "scope": [
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ffb547"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#ffb547"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#64d2ff"
      }
    },
    {
      "name": "Type / class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#c792ff"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#c2cfdc"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#93a8bf",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#93a8bf"
      }
    },
    {
      "name": "this / self",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#ff5470",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#c792ff"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml"
      ],
      "settings": {
        "foreground": "#5ee1ff"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ffb547",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS selector",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#64d2ff"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff5470"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ffb547",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "markup.heading entity.name",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#5ee1ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#d6e4f2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#c2cfdc",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#64d2ff"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#3dffa8"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#93a8bf",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "beginning.punctuation.definition.list.markdown"
      ],
      "settings": {
        "foreground": "#ffb547"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#3dffa8"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ff5470"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#ffb547"
      }
    },
    {
      "name": "Diff header",
      "scope": [
        "meta.diff.header",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#5ee1ff"
      }
    },
    {
      "name": "JSON key",
      "scope": [
        "source.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#5ee1ff"
      }
    },
    {
      "name": "Shell variable",
      "scope": [
        "variable.other.normal.shell",
        "punctuation.definition.variable.shell"
      ],
      "settings": {
        "foreground": "#ffb547"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#c792ff",
    "type": "#c792ff",
    "class": "#c792ff",
    "enum": "#c792ff",
    "interface": "#c792ff",
    "struct": "#c792ff",
    "typeParameter": {
      "foreground": "#c792ff",
      "italic": true
    },
    "parameter": {
      "foreground": "#93a8bf",
      "italic": true
    },
    "variable": "#c2cfdc",
    "variable.readonly": "#ffb547",
    "variable.defaultLibrary": "#ffb547",
    "property": "#93a8bf",
    "property.readonly": "#93a8bf",
    "enumMember": "#ffb547",
    "function": "#64d2ff",
    "method": "#64d2ff",
    "function.defaultLibrary": "#64d2ff",
    "macro": "#3ef0ff",
    "keyword": "#5ee1ff",
    "comment": {
      "foreground": "#7d93ad",
      "italic": true
    },
    "string": "#3dffa8",
    "number": "#ffb547",
    "regexp": "#3ef0ff",
    "operator": "#93a8bf",
    "decorator": "#c792ff",
    "label": "#ffb547",
    "selfParameter": {
      "foreground": "#ff5470",
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
